<?php

/**
 * ================================================================
 * ARTISAN WEB RUNNER — Untuk Hostinger Tanpa SSH
 * ================================================================
 * 
 * ⚠️  PERINGATAN KEAMANAN:
 *     File ini adalah BACKDOOR. HAPUS SEGERA setelah setup selesai!
 *     Jangan biarkan file ini di server production.
 * 
 * CARA PAKAI:
 *     1. Upload ke public_html/
 *     2. Buka: https://namadomain.com/artisan_web.php
 *     3. Klik tombol untuk menjalankan command
 *     4. HAPUS file ini setelah semua selesai
 * 
 * ================================================================
 */

// =========================================================
// KEAMANAN: Ganti token ini dengan string acak kamu sendiri
// =========================================================
$SECURITY_TOKEN = '070505';

// Cek token
$inputToken = $_GET['token'] ?? $_POST['token'] ?? '';
$isAuthenticated = ($inputToken === $SECURITY_TOKEN);

// Path ke project Laravel
$projectPath = __DIR__ . '/../project-lspro';

/**
 * Jalankan artisan command
 */
function runArtisan($projectPath, $command) {
    $fullCommand = "cd " . escapeshellarg($projectPath) . " && php artisan " . $command . " 2>&1";
    $output = [];
    $returnVar = 0;
    exec($fullCommand, $output, $returnVar);
    return [
        'command' => "php artisan " . $command,
        'output' => implode("\n", $output),
        'success' => $returnVar === 0,
        'return_code' => $returnVar,
    ];
}

// Handle POST request
$result = null;
if ($_SERVER['REQUEST_METHOD'] === 'POST' && $isAuthenticated) {
    $command = $_POST['command'] ?? '';
    
    $allowedCommands = [
        'key:generate --force',
        'migrate --force',
        'db:seed --class=SuperadminSeeder --force',
        'storage:link',
        'config:cache',
        'config:clear',
        'route:cache',
        'route:clear',
        'view:cache',
        'view:clear',
        'cache:clear',
        'optimize',
        'optimize:clear',
    ];
    
    if (in_array($command, $allowedCommands)) {
        $result = runArtisan($projectPath, $command);
    } else {
        $result = [
            'command' => $command,
            'output' => '❌ Command tidak diizinkan!',
            'success' => false,
        ];
    }
}

?>
